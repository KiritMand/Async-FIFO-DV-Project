# SymbiYosys job for T18. Run one task with: sby -f t18.sby <task>

# prove: k-induction; pdr: abc pdr with the assumption; pdr_noasm: without it (must fail);
# break: bmc with BREAK (must fail by label); cover: reach the cover; hier: hierarchical reference
# (hier_strict: the same under `default_nettype none).
# Tag plain = read without defines; tag pdr_eng = use abc pdr.
[tasks]
prove plain
pdr pdr_eng plain
pdr_noasm pdr_eng
break
cover plain
hier hier_bmc
hier_strict hier_bmc

# Modes and depths; multiclock on gives the gclk and the clk2fflogic model.
[options]
prove: mode prove
pdr_eng: mode prove
break: mode bmc
break: depth 10
cover: mode cover
cover: depth 12
hier_bmc: mode bmc
hier_bmc: depth 6
multiclock on

# smtbmc/yices for everything except the pdr tasks, which use abc pdr.
[engines]
pdr_eng: abc pdr
~pdr_eng: smtbmc yices

# Read with FORMAL and the task's define, elaborate t18_top as top.
[script]
pdr_noasm: read -formal -DNOASM t18_hier.sv
break: read -formal -DBREAK t18_hier.sv
hier: read -formal -DHIER t18_hier.sv
hier_strict: read -formal -DHIER -DSTRICT t18_hier.sv
plain: read -formal t18_hier.sv
prep -top t18_top

# Source copied into each task directory.
[files]
t18_hier.sv
