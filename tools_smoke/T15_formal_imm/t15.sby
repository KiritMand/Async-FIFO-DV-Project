# SymbiYosys job for T15. Run one task with: sby -f t15.sby <task>

# bmc: no failure within 20 steps; prove: k-induction (recorded, not judged: see run.sh);
# cover: reach both covers; bad: BREAK must fail.
[tasks]
bmc
prove
cover
bad

# multiclock on: clka/clkb are ordinary inputs stepped on the global clock.
[options]
bmc: mode bmc
bmc: depth 20
prove: mode prove
cover: mode cover
cover: depth 30
bad: mode bmc
bad: depth 20
multiclock on

# yosys-smtbmc with yices, as in T4.
[engines]
smtbmc yices

# Read with FORMAL defined (and BREAK for the bad task), elaborate t15_imm as top.
[script]
bad: read -formal -DBREAK t15_imm.sv
~bad: read -formal t15_imm.sv
prep -top t15_imm

# Source copied into each task directory.
[files]
t15_imm.sv
