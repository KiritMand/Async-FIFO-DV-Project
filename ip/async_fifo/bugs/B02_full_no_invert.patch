# B02_full_no_invert.patch — planted bug B02 (M8; vplan §6), against tag rtl-v1.
#
# Full compare without the MSB inversion (the empty-style compare).
# wfull asserts when the write pointer equals the synchronized read pointer, i.e. at fill 0:
# an idle empty FIFO goes full and stays dead, and a FIFO that keeps filling is never full
# at DEPTH (overflow). Violates F06, F08, F12.
#
# Applied by common/scripts/bug_matrix.py to a copy of rtl-v1 (never to rtl/).
# Check by hand: git apply --check ip/async_fifo/bugs/B02_full_no_invert.patch
--- a/ip/async_fifo/rtl/async_fifo.sv
+++ b/ip/async_fifo/rtl/async_fifo.sv
@@ -72,7 +72,7 @@
 
   // Full: the next gray write pointer equals the synchronized gray read pointer with its two
   // MSBs inverted, i.e. the writer is exactly DEPTH entries (one lap) ahead of the reader.
-  assign wfull_next = (wgray_next == {~wq2_rptr[ASIZE:ASIZE-1], wq2_rptr[ASIZE-2:0]});
+  assign wfull_next = (wgray_next == wq2_rptr);
 
   // Write pointer and full flag. Loading wfull from *_next makes it see this edge's own write,
   // so the next edge can never overfill. wfull resets to 0.
