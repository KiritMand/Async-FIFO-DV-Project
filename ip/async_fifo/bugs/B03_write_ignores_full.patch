# B03_write_ignores_full.patch — planted bug B03 (M8; vplan §6), against tag rtl-v1.
#
# Memory write enable ignores wfull.
# The pointer still holds on a blocked write, but the memory is written: at true full the
# write address is the oldest unread entry, so that entry is overwritten. Needs a write
# attempt while really full (not just while the flag lags). Violates F04, F02.
#
# Applied by common/scripts/bug_matrix.py to a copy of rtl-v1 (never to rtl/).
# Check by hand: git apply --check ip/async_fifo/bugs/B03_write_ignores_full.patch
--- a/ip/async_fifo/rtl/async_fifo.sv
+++ b/ip/async_fifo/rtl/async_fifo.sv
@@ -91,7 +91,7 @@
   // Memory write port: store wdata only on an accepted write. The !wfull gate is what makes a
   // write while full harmless.
   always_ff @(posedge wclk) begin
-    if (winc && !wfull) mem[wbin[ASIZE-1:0]] <= wdata;
+    if (winc) mem[wbin[ASIZE-1:0]] <= wdata;
   end
 
   // The gray write pointer leaves the write domain only through this net.
